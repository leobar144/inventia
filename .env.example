# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Google Meet / Google API
NEXT_PUBLIC_GOOGLE_MEET_CLIENT_ID=your_google_client_id_here
GOOGLE_MEET_CLIENT_SECRET=your_google_client_secret_here

# Wompi (pagos) — https://comercios.wompi.co
NEXT_PUBLIC_WOMPI_PUBLIC_KEY=pub_test_xxx
WOMPI_PRIVATE_KEY=prv_test_xxx
WOMPI_INTEGRITY_SECRET=test_integrity_xxx
WOMPI_EVENTS_SECRET=test_events_xxx

# Resend (correo de notificación de reservas) — https://resend.com
RESEND_API_KEY=re_xxx
ADMIN_NOTIFICATION_EMAIL=owner@example.com

# Sala fija de Google Meet para las clases de prueba
NEXT_PUBLIC_TRIAL_MEET_LINK=https://meet.google.com/xxx-xxxx-xxx

# Next.js
NEXT_PUBLIC_APP_URL=https://inventiagroup.com
NODE_ENV=production

# Email Configuration
NEXT_PUBLIC_CONTACT_EMAIL=info@inventiagroup.com
NEXT_PUBLIC_WHATSAPP=3502114492

# Analytics (Optional)
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=your_ga_id_here
